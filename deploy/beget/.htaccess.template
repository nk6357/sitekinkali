Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Replace both placeholders during deployment. The application directory must
# stay outside the public document root, so its .env file is never downloadable.
PassengerNodejs __NODE_BINARY__
PassengerAppRoot __APP_ROOT__
PassengerAppType node
PassengerStartupFile passenger.cjs

<IfModule mod_headers.c>
  # Vite adds hashes to generated CSS and JavaScript filenames, so these files
  # can be cached permanently without keeping an outdated version after deploys.
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts and interface icons change rarely.
  <FilesMatch "\.(?:woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
  </FilesMatch>

  # Dish and restaurant images keep their filenames when replaced. A shorter
  # lifetime keeps them fast while allowing updates to appear automatically.
  <FilesMatch "\.(?:avif|webp|png|jpe?g|gif|svg|ico|pdf|docx)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # The application shell must always check for a newer deployment.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://yandex.ru https://*.yandex.ru; img-src 'self' data:; object-src 'none'; script-src 'self' 'sha256-X5OST9ensoCYWNEl7eB8i35nf6Xh4kzvSToyfu/pdtk='; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"

</IfModule>

RewriteEngine On

# The public address is always HTTPS without www. Technical domains, the
# request path, and the query string are preserved by the redirect.
RewriteCond %{HTTP_HOST} !^kinkali\.ru(?::[0-9]+)?$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://kinkali.ru%{REQUEST_URI} [R=301,L,NE]

# API requests must reach the Passenger application instead of the static 404
# handler below.
RewriteRule ^api(?:/|$) - [L]

# The build creates static entry points for legal pages. /call remains a client
# route because the phone number is carried in the URL fragment.
RewriteRule ^call/?$ index.html [L]
