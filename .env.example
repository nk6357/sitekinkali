# Copy this file to .env.local for local development.
# Never commit .env.local or real passwords.

# SMTP server used by both Timeweb and Vercel.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@example.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=orders@example.com
SMTP_FROM_NAME=Ресторан Кинкали

# Orders are sent here. Replace this test address before production.
ADMIN_EMAIL=hazelmind@bk.ru

# Comma-separated external frontend origins, without trailing slashes.
# Same-host requests are allowed automatically.
ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-domain.ru

# Order configuration.
PICKUP_LOCATION=Самовывоз Белинского, 6Б
PAYMENT_METHOD=Оплата наличными или банковской картой при получении заказа
ORDER_TIME_ZONE=Asia/Yekaterinburg
ORDER_RATE_LIMIT_MAX=5
ORDER_RATE_LIMIT_WINDOW_MS=900000

# Timeweb Node.js server settings.
PORT=3000
NODE_ENV=production
TRUST_PROXY=true
