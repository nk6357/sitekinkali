# Copy this file to .env.local for local development.
# Never commit .env.local or real passwords.

# Mail.ru SMTP settings for the restaurant mailbox.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=luckykinkali@mail.ru
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=luckykinkali@mail.ru
SMTP_FROM_NAME=Ресторан Кинкали

# Orders and table reservation requests are sent here.
ADMIN_EMAIL=luckykinkali@mail.ru

# Comma-separated external frontend origins, without trailing slashes.
# Same-host requests are allowed automatically.
ALLOWED_ORIGINS=https://kinkali.ru,https://www.kinkali.ru,https://kinkali-ten.vercel.app

# Order configuration.
PICKUP_LOCATION=Самовывоз Белинского, 6Б
PAYMENT_METHOD=Оплата наличными или банковской картой при получении заказа
ORDER_TIME_ZONE=Asia/Yekaterinburg
ORDER_RATE_LIMIT_MAX=5
ORDER_RATE_LIMIT_WINDOW_MS=900000

# Timeweb Node.js server settings.
PORT=3000
NODE_ENV=production
TRUST_PROXY=true
